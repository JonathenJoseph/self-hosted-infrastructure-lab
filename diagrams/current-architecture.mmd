flowchart TB
    subgraph Remote["Remote access options"]
        RemoteDevice["Remote devices"]
        Twingate["Twingate<br/>Remote access"]
        Teleport["UniFi Teleport<br/>Remote VPN option"]

        RemoteDevice --> Twingate
        RemoteDevice --> Teleport
    end

    subgraph HomeNetwork["Home network"]
        Gateway["UniFi gateway<br/>Local DNS and LAN routing"]
    end

    Twingate -. "Independent access path" .-> Gateway
    Teleport -. "Independent access path" .-> Gateway

    subgraph Host["Self-hosted host platform"]
        Windows["Windows 11 host"]
        DockerDesktop["Docker Desktop"]
        DockerEngine["Shared Docker daemon"]
        WSL["Ubuntu on WSL 2<br/>Docker CLI client"]

        Windows --> DockerDesktop
        DockerDesktop --> DockerEngine
        WSL -->|"Uses same daemon"| DockerEngine
    end

    Gateway --> Windows

    subgraph Applications["Containerised services"]
        Caddy["Caddy<br/>HTTP and HTTPS reverse proxy"]
        Immich["Immich application"]
        ImmichData["PostgreSQL and supporting services"]
        OtherApps["Other self-hosted applications"]
        DNS["DNS-related services"]

        Immich --> ImmichData
    end

    DockerEngine --> Caddy
    DockerEngine --> Immich
    DockerEngine --> OtherApps
    DockerEngine --> DNS

    Caddy -. "Configured application routes" .-> Immich
    Caddy -. "Configured application routes" .-> OtherApps

    subgraph Backup["Backup and recovery"]
        BackupJob["Scheduled Restic backup"]
        EncryptedRepo["Encrypted external repository<br/>3 snapshots after the recorded<br/>2 November retention run"]
        RestoreTest["Isolated PostgreSQL restore test"]

        BackupJob --> EncryptedRepo
        EncryptedRepo --> RestoreTest
    end

    Windows --> BackupJob
    ImmichData -. "Database dump and application data" .-> BackupJob

